# Firebase Admin credentials (service account)
# 1. Firebase Console → Project Settings → Service accounts → Generate new private key.
# 2. Open the downloaded JSON. Copy these three values out of it:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value as-is, including the literal \n sequences inside the string.
# In Render's dashboard, paste the value exactly as it appears in the JSON file (with \n inside).
# The server replaces \n with newlines at startup.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...REPLACE_ME...\n-----END PRIVATE KEY-----\n"

# Comma-separated allowed origins for CORS (your static site URL + custom domain).
# Example: https://agfintax.com,https://www.agfintax.com,https://agfintax-site.onrender.com
ALLOWED_ORIGIN=

# Render injects PORT automatically; only set this locally.
# PORT=8080
