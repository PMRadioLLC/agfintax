# Required
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service-role key (server-only, never expose to browser)

# Comma-separated allowed origins for CORS (your static site URL + custom domain).
# Example: https://agfintax.com,https://www.agfintax.com,https://agfintax-site.onrender.com
ALLOWED_ORIGIN=

# Render injects PORT automatically; only set this locally.
# PORT=8080
